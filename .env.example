# Mise — environment variables (Railway service variables in production)

# --- required to run ---
APP_PASSWORD=change-me                # single-user login password
SESSION_SECRET=generate-a-long-random-string

# --- database (Railway Postgres plugin provides this) ---
DATABASE_URL=postgresql://user:pass@host:5432/mise

# --- app ---
DEFAULT_TZ=America/Los_Angeles
DEV_MODE=0                            # 1 = allow non-HTTPS session cookie (local dev only)

# --- Google Workspace service account (milestone 3) ---
# Raw service-account JSON, or a path to the JSON file. The SA needs
# domain-wide delegation authorized for both mailboxes with scopes:
# gmail.readonly, gmail.compose, calendar.events (see docs/mise-spec.md §5).
# GOOGLE_SA_JSON=
# Mailbox overrides (defaults shown; canonical per spec):
# GMAIL_ARDA_ADDRESS=ardabarlas@boxxcoffee.com
# GMAIL_HELLO_ADDRESS=hello@boxxcoffee.com
# CALENDAR_ADDRESS=ardabarlas@boxxcoffee.com

# --- Anthropic (milestone 4+) ---
# ANTHROPIC_API_KEY=

# --- QuickBooks Online (milestone 8) — Intuit developer app credentials.
# Register redirect URI: https://<your-app-domain>/settings/qbo/callback
# then authorize via Settings -> QuickBooks -> Connect (stores the rotating
# refresh token in Postgres; QBO_REFRESH_TOKEN/QBO_REALM_ID are optional
# seeds only for a token minted elsewhere).
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REFRESH_TOKEN=
# QBO_REALM_ID=
# QBO_ENVIRONMENT=production
# QBO_CLIENT_SECRET=
# QBO_REFRESH_TOKEN=                  # bootstrap seed only — live token rotates in Postgres
# QBO_REALM_ID=
